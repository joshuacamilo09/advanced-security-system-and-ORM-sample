
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  name           String?
  password       String
  role           String    @default("user")
  hashedRt       String?   // hashed refresh token (rotativo) - opcional
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tasks          Task[]   
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  user        user?     @relation(fields: [userId], references: [id])
  userId      Int?
  createdAt   DateTime  @default(now())
}